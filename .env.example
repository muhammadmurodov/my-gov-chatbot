# Copy to .env and fill in. .env is gitignored — never commit real keys.

# OpenRouter API key — powers the answer-generation LLM call.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: which OpenRouter model generates answers + rewrites follow-ups.
# Defaults to the free auto-router, which is flaky (varies per call, so temp=0
# isn't deterministic and weak turns pollute chat history). Pin a real model for
# reliable multi-turn, e.g. openai/gpt-4o-mini or google/gemini-2.0-flash-001.
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: Postgres connection string. Defaults to the local-dev value
# (postgres:mygov@localhost:5433/mygov). Override to point at another DB or to
# keep the password out of source.
# DSN=postgresql://postgres:mygov@localhost:5433/mygov

# Optional: a Hugging Face token raises model-download rate limits.
# Not required once bge-m3 / bge-reranker-v2-m3 are cached locally.
# HF_TOKEN=
